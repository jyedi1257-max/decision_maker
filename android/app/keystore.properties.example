# 이 파일을 keystore.properties로 복사해서 채운다 (그 이름은 .gitignore에 있다 — 커밋되지 않는다).
#
# 키스토어 자체를 만드는 법과 이 값들을 채우는 법은 docs/STORE_RELEASE.md 참고.
# storeFile은 이 폴더(android/app/) 기준 상대경로거나 절대경로 둘 다 된다.
# 저장소 바깥(예: ~/keys/decision-note-release.jks)에 두는 쪽을 권한다 — 실수로 커밋될 일이 없다.

storeFile=/absolute/path/to/decision-note-release.jks
storePassword=
keyAlias=decision-note
keyPassword=
